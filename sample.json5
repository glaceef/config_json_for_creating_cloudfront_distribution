/* DO NOT EDIT THIS FILE. */

{
  /* CloundFront作成リクエストを一意に識別する文字列。
    * 新しい値（過去に使用していない値）の場合、内容にかかわらず新しいディストリビューションを作成する。
    * すでに使用した値を指定した場合、作成リクエストはDistributionAlreadyExistsエラーを返す。*/
  CallerReference: "",

  // (任意)代替ドメイン名(CNAME)
  Aliases: {
    // Itemsの数
    Quantity: 0,
    // (任意)CNAMEエイリアス
    Items: [
      "test.mydomain.com"
    ]
  },

  // オリジン
  Origins: {
    // Itemsの数
    Quantity: 0,
    // オリジン
    Items: [
      {
        // Originを区別する一意な文字列。後から編集不可。
        // コンソールではDomainNameと同じ文字列がセットされる。
        // AWS-CLIでは存在するオリジンの名前のみ記述可能。
        Id: "",
        // AmazonS3バケット、またはHTTPサーバーのDNSドメイン名
        DomainName: "",
        // (任意)バケット以下のパス
        OriginPath: "",
        // (任意)CloudFrontがオリジンに送信するリクエストに追加するHTTPヘッダー
        CustomHeaders: {
          // Itemsの数
          Quantity: 0,
          // (任意)
          Items: [
            {
              HeaderName: "",
              HeaderValue: ""
            }
          ]
        },
        // (任意)
        S3OriginConfig: { // 中身がなくても記述しないとダメらしい
          OriginAccessIdentity: "",
        },
        // (任意)
        CustomOriginConfig: {
          HTTPPort: 0,
          HTTPSPort: 0,
          OriginProtocolPolicy: "http-only",
          OriginSslProtocols: {
            Quantity: 0,
            Items: [
              "SSLv3"
            ]
          },
          OriginReadTimeout: 0, // デフォルトは30
          OriginKeepaliveTimeout: 0, // デフォルトは5
        },
        // (任意) オリジンシールド
        OriginShield: {
          Enabled: false,
          OriginShieldRegion: "", // trueの時だけ？
        },
        // (任意)オリジンへの接続試行回数
        ConnectionAttempts: 3, // デフォルトは3
        // (任意)オリジンへの接続を確立しようとしたときに待機する秒数
        ConnectionTimeout: 10, // デフォルトは10
      }
    ]
  },

  // (任意)オリジングループ
  OriginGroups: {
    Quantity: 0,
    Items: [
      {
        Id: "",
        FailoverCriteria: {
          StatusCodes: {
            Quantity: 0,
            Items: [
              0
            ]
          }
        },
        Members: {
          Quantity: 0,
          Items: [
            {
              OriginId: ""
            }
          ]
        }
      }
    ]
  },

  // デフォルトのキャッシュのふるまい
  // CacheBehaviorsを記述しない場合、もしくはそれらのパスパターンの
  // いずれにも一致しない場合のデフォルトのキャッシュ動作。
  DefaultCacheBehavior: {
    // CloudFrontがデフォルトのキャッシュ動作を使用するときにリクエストをルーティングするオリジンのID
    // OriginのIdを記述する。
    TargetOriginId: "",
    // (任意)オブジェクトを自動的に圧縮
    Compress: true,

    /* ビューワー */
    // ビューワープロトコルポリシー
    ViewerProtocolPolicy: "allow-all", // allow-all, https-only, redirect-to-https
    // (任意)許可された HTTP メソッド
    AllowedMethods: {
      // Itemsの数
      Quantity: 0,
      // HTTPメソッドの組み合わせ。以下の3通りのいずれかを選択可能
      // ・[GET, HEAD]
      // ・[GET, HEAD, OPTIONS]
      // ・[GET, HEAD, OPTIONS, PUT, POST, PATCH, DELETE]
      Items: [
        "GET",
        "HEAD",
      ],
      CachedMethods: { // GET, HEAD以外が指定されているとき必要（GET, HEADメソッドはデフォルトでキャッシュされる）
        Quantity: 0,
        Items: [
          "OPTIONS"
        ]
      },
    },
    // (任意)ビューワーのアクセスを制限する(Yes/No)
    // Noの場合不要。
    TrustedKeyGroups: { // recommended
      Enabled: true,
      Quantity: 0,
      Items: [
        ""
      ]
    },
    TrustedSigners: {
      Enabled: true,
      Quantity: 0,
      Items: [
        ""
      ]
    },

    /* 関数の関連付け */
    // (任意)関数への関連付け（ビューワーリクエスト／ビューワーレスポンス）
    // ベーシック認証など
    LambdaFunctionAssociations: {
      Quantity: 0,
      Items: [
        {
          EventType: "viewer-request",
          LambdaFunctionARN: "",
          IncludeBody: true,
        }
      ]
    },
    // (任意)関数への関連付け（オリジンリクエスト／オリジンレスポンス）
    FunctionAssociations: {
      Quantity: 0,
      Items: [
        {
          FunctionARN: "",
          EventType: "origin-request"
        }
      ]
    },

    /* キャッシュキーとオリジンリクエスト */
    // (選択) Cache policy and origin request policy (recommended)
    // https://docs.aws.amazon.com/ja_jp/AmazonCloudFront/latest/DeveloperGuide/using-managed-cache-policies.html#managed-cache-policies-list
    CachePolicyId: "658327ea-f89d-4fab-a63d-7e88639e58f6", // Managed-CachingOptimized
    OriginRequestPolicyId: "", // 任意
    // (選択, 非推奨) Legacy cache settings
    ForwardedValues: { 
      QueryString: true,
      Cookies: {
        Forward: "all",
        WhitelistedNames: {
          Quantity: 0,
          Items: [
            ""
          ]
        }
      },
      Headers: {
        Quantity: 0,
        Items: [
          ""
        ]
      },
      QueryStringCacheKeys: {
        Quantity: 0,
        Items: [
          ""
        ]
      }
    },
    // (任意)オブジェクトキャッシュ
    // "Legacy cache settings" を選択しオブジェクトキャッシュで Customize を選択すると表示される
    DefaultTTL: 0,
    MinTTL: 0,
    MaxTTL: 0,

    /* 追加設定 */
    // (任意)スムーズストリーミング
    SmoothStreaming: false,
    // (任意)フィールドレベルの暗号化
    FieldLevelEncryptionId: "",
    // (任意)リアルタイムログの有効化
    RealtimeLogConfigArn: "",
  },

  // (任意)
  CacheBehaviors: {
    Quantity: 0,
    Items: [
      {
        PathPattern: "",
        TargetOriginId: "",
        TrustedSigners: {
          Enabled: true,
          Quantity: 0,
          Items: [
            ""
          ]
        },
        TrustedKeyGroups: {
          Enabled: true,
          Quantity: 0,
          Items: [
            ""
          ]
        },
        ViewerProtocolPolicy: "allow-all",
        AllowedMethods: {
          Quantity: 0,
          Items: [
            "PUT"
          ],
          CachedMethods: {
            Quantity: 0,
            Items: [
              "DELETE"
            ]
          }
        },
        SmoothStreaming: true,
        Compress: true,
        LambdaFunctionAssociations: {
          Quantity: 0,
          Items: [
            {
              LambdaFunctionARN: "",
              EventType: "viewer-request",
              IncludeBody: true
            }
          ]
        },
        FunctionAssociations: {
          Quantity: 0,
          Items: [
            {
              FunctionARN: "",
              EventType: "viewer-request"
            }
          ]
        },
        FieldLevelEncryptionId: "",
        RealtimeLogConfigArn: "",
        CachePolicyId: "",
        OriginRequestPolicyId: "",
        ForwardedValues: {
          QueryString: true,
          Cookies: {
            Forward: "all",
            WhitelistedNames: {
              Quantity: 0,
              Items: [
                ""
              ]
            }
          },
          Headers: {
            Quantity: 0,
            Items: [
              ""
            ]
          },
          QueryStringCacheKeys: {
            Quantity: 0,
            Items: [
              ""
            ]
          }
        },
        MinTTL: 0,
        DefaultTTL: 0,
        MaxTTL: 0
      }
    ]
  },

  // (任意)標準ログ記録
  Logging: {
    Enabled: true, // trueの場合は以下のキーを使用する
    Bucket: "", // S3バケット
    Prefix: "", // (任意)ログプレフィックス
    IncludeCookies: true, // ログにcookieを含めるか
  },

  /* その他の設定 */
  // (任意)料金クラス
  // ・PriceClass_100 : 北米と欧州のみ
  // ・PriceClass_200 : ＋アジア、中東、アフリカ
  // ・PriceClass_ALL : すべてのエッジロケーション
  PriceClass: "PriceClass_100",
  // (任意)AWS WAF ウェブ ACL
  WebACLId: "",
  // (任意)独自ドメイン用サーバ証明書（カスタムドメイン設定）
  ViewerCertificate: {
    CloudFrontDefaultCertificate: true,
    IAMCertificateId: "",
    ACMCertificateArn: "",
    SSLSupportMethod: "sni-only",
    MinimumProtocolVersion: "TLSv1",
    Certificate: "",
    CertificateSource: "acm"
  },
  // (任意)サポートされている HTTP バージョン
  // HTTP/1.0 および HTTP/1.1 はデフォルトでサポートされているので、http2 を必要とする場合のみこのキーを含める。
  HttpVersion: "http2", // http1.1, http2
  // (任意) https://example.com/ のように / でアクセスされたときに返すもの
  // オブジェクト名のみを指定する。先頭に / を付けない。
  DefaultRootObject: "",
  // (任意) IPv6を有効にするか
  IsIPV6Enabled: true,
  // コメント
  Comment: "",
  // 有効にするか
  Enabled: true,

  // (任意)カスタムエラーレスポンス
  CustomErrorResponses: {
    Quantity: 0,
    Items: [
      {
        ErrorCode: 0,
        ResponsePagePath: "",
        ResponseCode: "",
        ErrorCachingMinTTL: 0
      }
    ]
  },

  // (任意)地理的制限
  Restrictions: {
    GeoRestriction: {
      RestrictionType: "whitelist",
      Quantity: 0,
      Items: [
        ""
      ]
    }
  },
}
