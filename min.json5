/* DO NOT EDIT THIS FILE. */

{
  /* CloundFront作成リクエストを一意に識別する文字列。
   * 新しい値（過去に使用していない値）の場合、内容にかかわらず新しいディストリビューションを作成する。
   * すでに存在する値を指定した場合、作成リクエストはDistributionAlreadyExistsエラーを返す。
   * 削除済みであれば（存在するディストリビューションに使用されていない値であれば）過去に使用した値も使用可能。 */
  CallerReference: "20210101_3",

  // オリジン
  Origins: {
    // Itemsの数
    Quantity: 1,
    // オリジン
    Items: [
      {
        // Originを区別する一意な文字列。後から編集不可。
        // コンソールではDomainNameと同じ文字列がセットされる。
        // AWS-CLIでは存在するオリジンの名前のみ記述可能。
        Id: "mw-test-20210827.s3.ap-northeast-1.amazonaws.com",
        // AmazonS3バケット、またはHTTPサーバーのDNSドメイン名
        DomainName: "mw-test-20210827.s3.ap-northeast-1.amazonaws.com",
        // (任意)バケット以下のパス
        // OriginPath: "",
        // (任意)
        // 中身がなくても記述しないとダメらしい
        S3OriginConfig: {
          OriginAccessIdentity: "origin-access-identity/cloudfront/E2519N4SPBJEUC",
        },
      }
    ]
  },

  // デフォルトのキャッシュのふるまい
  // CacheBehaviorsを記述しない場合、もしくはそれらのパスパターンの
  // いずれにも一致しない場合のデフォルトのキャッシュ動作。
  DefaultCacheBehavior: {
    // CloudFrontがデフォルトのキャッシュ動作を使用するときにリクエストをルーティングするオリジンのID
    // OriginのIdを記述する。
    TargetOriginId: "mw-test-20210827.s3.ap-northeast-1.amazonaws.com",
    // (任意)オブジェクトを自動的に圧縮
    // Compress: true,

    /* ビューワー */
    // ビューワープロトコルポリシー
    ViewerProtocolPolicy: "allow-all", // allow-all, https-only, redirect-to-https
    // (任意)許可された HTTP メソッド
    AllowedMethods: {
      // Itemsの数
      Quantity: 2,
      Items: [
        "GET",
        "HEAD",
      ],
    },

    /* 関数の関連付け */
    // (任意)関数への関連付け（ビューワーリクエスト／ビューワーレスポンス）
    // ベーシック認証など
    /*
    LambdaFunctionAssociations: {
      Quantity: 1,
      Items: [
        {
          EventType: "viewer-request",
          LambdaFunctionARN: "arn:aws:lambda:us-east-1:437307506719:function:testLambdaFunction3:1",
          IncludeBody: false,
        }
      ]
    },
    */

    /* キャッシュキーとオリジンリクエスト */
    // (選択) Cache policy and origin request policy (recommended)
    // https://docs.aws.amazon.com/ja_jp/AmazonCloudFront/latest/DeveloperGuide/using-managed-cache-policies.html#managed-cache-policies-list
    CachePolicyId: "658327ea-f89d-4fab-a63d-7e88639e58f6", // Managed-CachingOptimized
    // OriginRequestPolicyId: "", // 任意
  },

  /* その他の設定 */
  // (任意)料金クラス
  // ・PriceClass_100 : 北米と欧州のみ
  // ・PriceClass_200 : ＋アジア、中東、アフリカ
  // ・PriceClass_ALL : すべてのエッジロケーション
  PriceClass: "PriceClass_200",
  // (任意)サポートされている HTTP バージョン
  // HTTP/1.0 および HTTP/1.1 はデフォルトでサポートされているので、http2 を必要とする場合のみこのキーを含める。
  HttpVersion: "http2", // http1.1, http2
  // (任意) https://example.com/ のように / でアクセスされたときに返すもの
  // オブジェクト名のみを指定する。先頭に / を付けない。
  DefaultRootObject: "",
  // (任意) IPv6を有効にするか
  IsIPV6Enabled: true,
  // コメント
  Comment: "コメント",
  // 有効にするか
  Enabled: true,
}
